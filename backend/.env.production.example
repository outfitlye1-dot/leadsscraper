# Production deploy (Vercel frontend + Railway backend)
# Full steps: see DEPLOY.md

# --- Required on Railway ---
ENVIRONMENT=production
SECRET_KEY=replace-with-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Railway Postgres plugin sets DATABASE_URL automatically — leave as injected.

FRONTEND_URL=https://YOUR-APP.vercel.app
CORS_ORIGINS=https://YOUR-APP.vercel.app
BACKEND_PUBLIC_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMeStrongPassword123!
ADMIN_NAME=Super Admin

# OTP emails must work in production (OTP_DEV_MODE stays false)
OTP_DEV_MODE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=LeadGen AI

# OAuth — add matching URIs in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=https://YOUR-RAILWAY-SERVICE.up.railway.app/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-APP.vercel.app/api/email-outreach/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://YOUR-APP.vercel.app/api/email-outreach/oauth/microsoft/callback

# Keep WhatsApp Web OFF on Railway (needs local Chrome / CDP)
WA_WEB_ENABLED=false

# Scraper Playwright works in Docker image (Chromium installed)
SCRAPER_ENABLE_PLAYWRIGHT=true
SCRAPER_PLAYWRIGHT_MAPS_CONCURRENCY=1
SCRAPER_PLAYWRIGHT_MAPS_MAX_SECONDS=90
SCRAPER_PLAYWRIGHT_CONTEXTS=1
SCRAPER_PARALLEL_SOURCES=false
SCRAPER_INTERNET_BEFORE_MAPS=false
SCRAPER_FAST_MODE=true
OUTREACH_WORKER_ENABLED=true
WEB_CONCURRENCY=1
