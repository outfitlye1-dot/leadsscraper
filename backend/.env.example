SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq API keys: add in the app as admin (Admin → API Keys). Shared by all users.
# Apify keys are optional (Meta Ads only). Google Maps uses local Playwright.
GROQ_MODEL=groq/compound-mini
APIFY_META_ADS_ACTOR_ID=scrapemint/facebook-ads-library-scraper

DATABASE_URL=sqlite:///./leadgen.db

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
SCRAPER_WORKERS=30
SCRAPER_MIN_WORKERS=8
SCRAPER_MAX_WORKERS=40
SCRAPER_SEARCH_MAX_WORKERS=40
SCRAPER_TIMEOUT=8
SCRAPER_BING_PAGES=1
SCRAPER_DISCOVERY_MULTIPLIER=2
SCRAPER_CRAWL_SEED_MULTIPLIER=2
SCRAPER_FAST_MODE=false
# Extra free internet search engines (comma-separated): brave,yahoo,mojeek
SCRAPER_EXTRA_ENGINES=brave,yahoo,mojeek
# Optional self-hosted SearXNG instance, e.g. https://searx.example.com
SCRAPER_SEARXNG_URL=
# Overlap multi-engine search with parallel website crawls under high load
SCRAPER_INTERNET_PIPELINE=true
SCRAPER_PIPELINE_CRAWL_START=4
# Hard stop so Internet scrapes finish (seconds)
SCRAPER_INTERNET_MAX_SECONDS=90
SCRAPER_VERIFY_EMAIL_MX=true

# Gmail OTP — uses SMTP + App Password (NOT Google OAuth client secret)
# OAuth below is only for Email Outreach (users connecting their Gmail to send leads).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=LeadGen AI
OTP_DEV_MODE=false
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
# Email outreach OAuth (optional — for Gmail/Outlook account connection)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/email-outreach/oauth/google/callback
# Add ALL of these in Google Cloud Console → APIs & Services → Credentials →
# your OAuth 2.0 Client ID → Authorized redirect URIs (exact match, no trailing slash):
#   http://localhost:3000/api/auth/google/callback
#   http://127.0.0.1:3000/api/auth/google/callback
#   http://localhost:3000/api/email-outreach/oauth/google/callback
#   http://127.0.0.1:3000/api/email-outreach/oauth/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/email-outreach/oauth/microsoft/callback
FRONTEND_URL=http://localhost:3000
OUTREACH_WORKER_ENABLED=true

# local | production
ENVIRONMENT=local

# Admin bootstrap (creates/updates admin on startup)
ADMIN_EMAIL=admin@leadgen.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin

# Pro plan purchase
PRO_PLAN_PRICE_USD=29
PRO_PLAN_PRICE_PKR=8500
PRO_PLAN_CHECKOUT_URL=
PRO_PLAN_CONTACT_EMAIL=
BACKEND_PUBLIC_URL=http://127.0.0.1:8001

# JazzCash — register at https://sandbox.jazzcash.com.pk (sandbox) for test credentials
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true
JAZZCASH_VERSION=1.1
JAZZCASH_TXN_TYPE=MWALLET

# WhatsApp Cloud API (Meta Graph) — get from developers.facebook.com
# NEVER commit real tokens. Rotate if a token was ever pasted in chat/email.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEST_DISPLAY_NUMBER=
# Meta webhook verify token (must match Callback Verify Token in Meta dashboard)
WHATSAPP_VERIFY_TOKEN=leadgen_wa_verify

# WhatsApp Web automation via Playwright (OPTIONAL — default off)
# Does NOT replace Cloud API. Keep false unless you intentionally use Web session.
WA_WEB_ENABLED=false
WA_WEB_PROFILE_DIR=data/wa_web_profile
# First login: set false so you can see/scan QR; later can use true
WA_WEB_HEADLESS=false
WA_WEB_POLL_SECONDS=3
WA_WEB_AUTO_START_WORKER=true
# Owner account for AI Brain / lead matching (defaults to ADMIN_EMAIL)
WA_WEB_USER_ID=0
WA_WEB_USER_EMAIL=
WA_WEB_MAX_REPLIES_PER_MIN=8
WA_WEB_TYPING_DELAY_MS=40
# Prefer installed Google Chrome (better Business linking than bundled Chromium)
WA_WEB_USE_CHROME=true
# Empty = Playwright launches Chrome. Set to attach to real Chrome (Business link):
#   1) powershell -File scripts/launch_wa_chrome.ps1
#   2) Link WhatsApp in that window
#   3) Connect in app
WA_WEB_CDP_URL=http://127.0.0.1:9222
