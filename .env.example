SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq & Apify API keys: add per user in the app (Settings → API Keys), not here.
GROQ_MODEL=groq/compound-mini
APIFY_ACTOR_ID=compass/crawler-google-places

DATABASE_URL=sqlite:///./leadgen.db

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
SCRAPER_WORKERS=8
SCRAPER_TIMEOUT=8
SCRAPER_VERIFY_EMAIL_MX=true

# Gmail OTP (App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=LeadGen AI
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
# Email outreach OAuth (optional — for Gmail/Outlook account connection)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/email-outreach/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/email-outreach/oauth/microsoft/callback
FRONTEND_URL=http://localhost:3000
OUTREACH_WORKER_ENABLED=true

# Admin bootstrap (creates/updates admin on startup)
ADMIN_EMAIL=admin@leadgen.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin
